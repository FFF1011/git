# ---- 依赖目录（不需要的内容）----
node_modules/

# ---- 构建产物 ----
dist/
build/
out/
*.tsbuildinfo

# ---- 依赖锁定文件 ----
# 注：npm 的 package-lock.json / yarn.lock / pnpm-lock.yaml 通常建议保留，这里不忽略

# ---- 系统文件 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 编辑器/IDE ----
.vscode/
.idea/
*.swp

# ---- 环境变量 / 密钥（绝不提交）----
.env
.env.*
!.env.example

# ---- 日志 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 临时文件 ----
*.tmp

# ---- 缓存 ----
.cache/
.cache-loader/
